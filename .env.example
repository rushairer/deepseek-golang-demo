DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=90s
AGENT_MAX_STEPS=6
AGENT_MAX_OUTPUT_TOKENS=4096

DB_DSN=deepseek:deepseek123@tcp(localhost:3306)/deepseek_demo?parseTime=true
PORT=8080
API_AUTH_TOKEN=replace_with_a_long_random_token
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BODY_BYTES=1048576

REQUIRE_NOTIFICATION_APPROVAL=true
NOTIFICATION_TIMEOUT=15s
EMAIL_TARGETS_JSON={"support":"support@example.com"}
WEBHOOK_TARGETS_JSON={"ops":"https://example.com/hooks/deepseek"}
ALLOW_HTTP_WEBHOOKS=false
ALLOW_PRIVATE_WEBHOOKS=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=agent@example.com
SMTP_STARTTLS=true
